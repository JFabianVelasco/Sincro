rules_version = '2';

// =========================================================
// SINCRO — firestore.rules
//
// Ahora Sincro SÍ usa Firebase Authentication (Google y
// correo/contraseña), así que estas reglas pueden apoyarse en
// request.auth.uid — una identidad real que Firestore verifica
// criptográficamente. Esto es un salto de seguridad real
// respecto a una versión sin Authentication.
//
// El modelo sigue siendo "código de invitación": cualquier
// persona autenticada que conozca el coupleId (6 caracteres)
// puede unirse como miembro de ese espacio. Es una decisión de
// producto (así funciona la invitación), no un descuido: por
// eso el código no debe compartirse fuera de la otra persona.
// Una vez alguien es miembro, el resto de reglas exige
// pertenecer a ese couple para leer o escribir sus datos.
// =========================================================

function isSignedIn() {
  return request.auth != null;
}

function isOwner(uid) {
  return isSignedIn() && request.auth.uid == uid;
}

function isMember(coupleId) {
  return isSignedIn() &&
    exists(/databases/$(database)/documents/couples/$(coupleId)/members/$(request.auth.uid));
}

function shortStr(v, n) {
  return v is string && v.size() <= n;
}

match /databases/{database}/documents {

  // Perfil privado de cada persona (nombre, género, país, coupleId).
  // Solo la propia persona puede leerlo o escribirlo.
  match /users/{uid} {
    allow read, write: if isOwner(uid);
  }

  match /couples/{coupleId} {

    // Cualquier persona autenticada puede comprobar que un código
    // de espacio existe (paso de "unirme"), pero no se puede listar
    // la colección completa de espacios.
    allow get: if isSignedIn();
    allow list: if false;
    allow create: if isSignedIn();
    allow update, delete: if false;

    match /members/{uid} {
      allow read: if isSignedIn();
      // Solo puedes crear/actualizar TU PROPIO documento de miembro,
      // y con los campos esperados.
      allow write: if isOwner(uid)
                   && request.resource.data.keys().hasAll(['displayName', 'country', 'timezone'])
                   && shortStr(request.resource.data.displayName, 24)
                   && shortStr(request.resource.data.country, 4)
                   && shortStr(request.resource.data.timezone, 60);
    }

    match /presence/{uid} {
      allow read: if isMember(coupleId);
      allow write: if isOwner(uid) && isMember(coupleId) && request.resource.data.size() <= 6;
    }

    match /notes/{noteId} {
      allow read: if isMember(coupleId);
      allow create: if isMember(coupleId)
                    && shortStr(request.resource.data.content, 500)
                    && request.resource.data.author == request.auth.uid;
      allow update: if isMember(coupleId)
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'readAt']);
      allow delete: if isMember(coupleId) && resource.data.author == request.auth.uid;
    }

    match /plans/{planId} {
      allow read: if isMember(coupleId);
      allow create: if isMember(coupleId)
                    && shortStr(request.resource.data.title, 60)
                    && request.resource.data.when is timestamp;
      allow update, delete: if isMember(coupleId);
    }

    match /lists/{listId} {
      allow read: if isMember(coupleId);
      allow create: if isMember(coupleId) && shortStr(request.resource.data.name, 40);
      allow update, delete: if isMember(coupleId);

      match /items/{itemId} {
        allow read: if isMember(coupleId);
        allow create: if isMember(coupleId) && shortStr(request.resource.data.text, 120);
        allow update, delete: if isMember(coupleId);
      }
    }

    match /checkins/{checkinId} {
      allow read: if isMember(coupleId);
      allow create: if isMember(coupleId)
                    && shortStr(request.resource.data.note, 200)
                    && request.resource.data.deviceId == request.auth.uid;
      allow update, delete: if false; // los check-ins son un registro, no se editan
    }

    match /activity/{activityId} {
      allow read: if isMember(coupleId);
      allow create: if isMember(coupleId) && shortStr(request.resource.data.summary, 240);
      allow update, delete: if false;
    }

    match /meeting/{docId} {
      allow read: if isMember(coupleId);
      allow write: if isMember(coupleId);

      match /todos/{todoId} {
        allow read: if isMember(coupleId);
        allow create: if isMember(coupleId) && shortStr(request.resource.data.text, 100);
        allow update, delete: if isMember(coupleId);
      }
    }
  }

  // Cualquier otra ruta no contemplada queda cerrada por defecto.
  match /{document=**} {
    allow read, write: if false;
  }
}
